{
  "name": "asciidoc-editor",
  "version": "0.9.0",
  "description": "A portable cross-platform AsciiDoc editor with live preview.",
  "author": "Kim Schulz <kim@schulz.dk>",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/vendor-mermaid.mjs && node scripts/vendor-pagedjs.mjs && vite build",
    "start": "electron .",
    "test": "node --test",
    "test:e2e": "playwright test",
    "package:linux": "npm run build && electron-builder --linux",
    "package:win": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "org.kimusan.asciidoceditor",
    "productName": "AsciiDoc Editor",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "kimusan",
      "repo": "asciidoc-editor"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/highlight.js/es/**",
      "!node_modules/highlight.js/scss/**",
      "!node_modules/highlight.js/styles/**",
      "node_modules/highlight.js/styles/github.css",
      "node_modules/highlight.js/styles/github-dark.css",
      "!node_modules/linkedom/esm/**",
      "!node_modules/linkedom/types/**"
    ],
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "electron/asciidoc-worker.cjs"
    ],
    "afterPack": "./electron-builder.after-pack.cjs",
    "electronLanguages": [
      "en-US"
    ],
    "icon": "build/icon.png",
    "linux": {
      "icon": "build/icon.png",
      "artifactName": "AsciiDoc.Editor-${version}.${ext}",
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman"
      ],
      "category": "Office"
    },
    "deb": {
      "artifactName": "asciidoc-editor-${version}_${arch}.${ext}"
    },
    "rpm": {
      "artifactName": "asciidoc-editor-${version}.${arch}.${ext}"
    },
    "pacman": {
      "artifactName": "asciidoc-editor-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "AsciiDoc.Editor.Setup.${version}.${ext}"
    },
    "portable": {
      "artifactName": "AsciiDoc.Editor.${version}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "artifactName": "AsciiDoc.Editor-${version}-win.${ext}",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.1",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.65.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.8.1",
    "mermaid": "^12.3.0",
    "pagedjs": "^0.4.3",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@asciidoctor/docbook-converter": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "electron-updater": "^6.8.11",
    "highlight.js": "^11.11.1",
    "linkedom": "^0.18.15",
    "mscgenjs": "^8.0.0",
    "nspell": "^2.1.5"
  }
}
